# ── Premium: Field Conditions ──
# Server-only (never exposed to the browser). Get from Supabase dashboard:
# Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. From your Xweather (AerisWeather) account dashboard.
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=

# Server-only. Set when you create the webhook in the RevenueCat dashboard
# (Project settings → Integrations → Webhooks) — pick your own random
# secret string and put the same value in both places.
REVENUECAT_WEBHOOK_SECRET=

# Public (embedded in the app bundle — this is normal/expected for RevenueCat
# keys, they're not sensitive the way the ones above are). From RevenueCat
# dashboard → Project settings → API keys.
